# Database
DATABASE_URL=postgresql://umira:umira_dev_password@localhost:5432/umira?schema=public

# Redis (rate limiting + cache)
REDIS_URL=redis://localhost:6379

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Auth
JWT_SECRET=replace_with_64_char_random_hex_string_in_production_environments_only
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AI providers (set at least one)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=info

# ── UMIRA Backend — Production Configuration ──────────────────────────
# Copy this file to .env and fill in all values before deploying.

# Application
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://umira:CHANGE_ME@localhost:5432/umira?schema=public

# Redis (optional — enables rate-limit persistence & caching)
# REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=https://app.umira.app,https://umira.app

# Auth
JWT_SECRET=generate_a_random_64_char_secret_here_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# AI Provider — options: openai, anthropic, mock
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

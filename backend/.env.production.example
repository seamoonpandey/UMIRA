# ═══════════════════════════════════════════════════════════════
# UMIRA Backend — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the secrets.
#
#   cp backend/.env.production.example backend/.env
#
# Required vars are marked with 🔴, optional with 🟢.
# ═══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# 🔴 Database connection string (PostgreSQL)
DATABASE_URL=postgresql://umira:password@localhost:5432/umira?schema=public

# 🟢 Redis connection (optional — used for AI job queue only)
REDIS_URL=redis://localhost:6379

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated origins allowed to access the API.
CORS_ORIGINS=https://umira.app

# ── Authentication ─────────────────────────────────────────────
# 🔴 JWT secret — at least 32 characters, use a strong random value
#    Generate one: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars_long

# Token expiry duration
JWT_EXPIRES_IN=7d

# ── AI Providers ───────────────────────────────────────────────
# Specify the active provider: openai | anthropic | mock
AI_PROVIDER=openai

# 🟢 OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 🟢 Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_MAX=100        # max requests per window
RATE_LIMIT_WINDOW=60000   # window in milliseconds (60s)

# ── Error Tracking (Sentry) ────────────────────────────────────
# 🟢 Set both to enable Sentry error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Monitoring (Prometheus) ────────────────────────────────────
# Set to "true" to expose /metrics for Prometheus scraping
PROMETHEUS_ENABLED=false

# ── AI Provider ──────────────────────────────────────────
# Choose one: openai | anthropic | nvidia | mock (default: mock)
# AI_PROVIDER=nvidia
# 
# NVIDIA NIM (OpenAI-compatible)
# NVIDIA_NIM_API_KEY=nvapi-...
# NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
#
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umira

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-char-min-secret
# JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────
# NODE_ENV=development
# PORT=4000
# CORS_ORIGINS=http://localhost:8080

# ── Rate Limiting ────────────────────────────────────────
# RATE_LIMIT_MAX_ANON=20
# RATE_LIMIT_MAX_FREE=60
# RATE_LIMIT_MAX_PRO=300
# RATE_LIMIT_WINDOW=60000

# ── Observability ───────────────────────────────────────
# LOG_LEVEL=info
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
# SENTRY_ENVIRONMENT=development
# PROMETHEUS_ENABLED=false

# ── Cache ────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
